{
  // --- CMake Tools ---
  // Use CMakePresets.json as the source of truth; default to the clang-cl preset.
  "cmake.useCMakePresets": "always",
  "cmake.configurePresetOnOpen": true,
  // Copy the active preset's compile_commands.json to a stable path so clangd
  // (which searches ./ and ./build) finds it regardless of which preset is active.
  "cmake.copyCompileCommands": "${workspaceFolder}/build/compile_commands.json",

  // --- IntelliSense: clangd owns it, the Microsoft C/C++ engine is disabled to
  //     avoid the two fighting. cpptools stays installed for its debugger only. ---
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": [
    "--header-insertion=never",
    "--background-index",
    "--clang-tidy"
  ],
  // clangd reads compile_commands.json from the active preset's build dir.
  "clangd.fallbackFlags": ["-std=c++20"],

  // --- Editor ---
  "editor.formatOnSave": true,
  "[cpp]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true
}
