{
  "version": "0.2.0",
  "configurations": [
    {
      // MSVC debugger (from the Microsoft C/C++ extension). Works on clang-cl
      // builds because they emit PDB debug info. Adjust "configuration" in the
      // path if you debug a Release build.
      "name": "Debug SpaceChase (clang-cl)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-clang-cl/bin/Debug/SpaceChase.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "CMake: build"
    },
    {
      "name": "Debug SpaceChase (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-msvc/bin/Debug/SpaceChase.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      // Linux: gdb through the Microsoft C/C++ extension. VS Code can't switch the
      // debugger "type" per OS, so each platform has its own entries here.
      "name": "Debug SpaceChase (Linux, gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/linux-clang/bin/Debug/SpaceChase",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [
        { "description": "Pretty-print STL types", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "CMake: build"
    },
    {
      "name": "Debug tests (Linux, gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/linux-clang/bin/Debug/SpaceChase_tests",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [
        { "description": "Pretty-print STL types", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "CMake: build"
    }
  ]
}
